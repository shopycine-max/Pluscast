<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="PlusCast Logo"
                    android:src="@android:drawable/ic_menu_slideshow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="PlusCast"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/cardLocalMedia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="Local Media (Phone Video / Audio)" />

            <EditText
                android:id="@+id/etStreamUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Direct Stream URL (M3U8 / MP4)"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnPlayStream"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="Play Direct Stream" />

            <EditText
                android:id="@+id/etM3uUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="M3U Playlist URL"
                android:inputType="textUri"
                android:maxLines="1" />

            <Button
                android:id="@+id/btnLoadIptv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:text="Load / Update IPTV Channels" />

            <EditText
                android:id="@+id/etSearchChannel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"
                android:hint="Search channel name or group..."
                android:inputType="text"
                android:maxLines="1" />

            <ListView
                android:id="@+id/lvIptvChannels"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="14dp"
                android:nestedScrollingEnabled="true" />

            <Button
                android:id="@+id/cardYoutube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YouTube Player" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
