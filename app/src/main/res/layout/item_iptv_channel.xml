<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pc_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/pc_surface_elevated"
        android:contentDescription="Channel Logo"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_gallery" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Channel Name"
            android:textColor="@color/pc_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChannelCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Category"
            android:textColor="@color/pc_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSourceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/pc_cast_badge_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:text="LIVE"
        android:textColor="@color/pc_accent_cyan"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
