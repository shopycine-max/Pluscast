<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit" />

    <TextView
        android:id="@+id/tvPlayerCastBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="#99101826"
        android:elevation="12dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="Source: Stream"
        android:textColor="#00E5FF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/playerControlsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPlayerCastLocal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="#99101826"
            android:contentDescription="Cast Local Media"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_upload"
            app:tint="#38BDF8" />

        <ImageButton
            android:id="@+id/btnPlayerCastYoutube"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="#99101826"
            android:contentDescription="Cast YouTube"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            app:tint="#FF4D6D" />

        <ImageButton
            android:id="@+id/btnRotateScreen"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#99000000"
            android:contentDescription="Rotate Screen"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="#FFFFFF" />
    </LinearLayout>

</FrameLayout>
